{
  "name": "github-uploader-telegram-bot",
  "version": "1.0.0",
  "description": "Telegram Bot to upload files and zip archives directly to GitHub repositories, deployable to Vercel and Cloudflare Workers",
  "main": "src/worker.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx src/dev.ts",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy:cf": "wrangler deploy"
  },
  "dependencies": {
    "@octokit/rest": "^20.1.1",
    "fflate": "^0.8.2",
    "grammy": "^1.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "wrangler": "^3.111.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
