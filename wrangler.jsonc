{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-uploader-bot",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS_KV",
      "id": "<YOUR_KV_NAMESPACE_ID>"
    }
  ]
}
