{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "github-uploader-bot",
	"main": "src/worker.ts",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "SESSIONS_KV",
			"id": "ac2e766e48c841c5a1727654ec3184bd",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "DB",
			"database_id": "5482e29c-15c6-4274-b942-46778b9642bd",
			"remote": true
		}
	]
}